{
  "name": "mantine-ai-elements",
  "version": "0.3.0",
  "description": "Composable AI SDK components for Mantine",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "pnpm docs:generate && storybook dev -p 6006 --no-open",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:storybook": "pnpm docs:generate && storybook build",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepack": "pnpm build",
    "verify:package": "node scripts/verify-package.mjs",
    "docs:generate": "node scripts/generate-docs.mjs"
  },
  "peerDependencies": {
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "ai": "^7.0.99",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.102",
    "@biomejs/biome": "2.5.13",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@playwright/test": "1.63.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.5.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "ai": "7.0.99",
    "jsdom": "^27.0.0",
    "postcss-preset-mantine": "^1.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gtnao/mantine-ai-elements.git"
  },
  "keywords": [
    "mantine",
    "ai-sdk",
    "react",
    "components",
    "chat"
  ],
  "homepage": "https://gtnao.github.io/mantine-ai-elements/",
  "bugs": {
    "url": "https://github.com/gtnao/mantine-ai-elements/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "cmdk": "1.1.1",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "8.6.0",
    "katex": "0.16.47",
    "react-jsx-parser": "2.4.1",
    "shiki": "3.22.0",
    "streamdown": "2.6.0",
    "tokenlens": "1.3.1",
    "use-stick-to-bottom": "^1.1.6"
  }
}
