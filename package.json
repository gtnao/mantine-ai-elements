{
  "name": "mantine-ai-elements",
  "version": "0.1.0",
  "description": "Composable AI SDK components for Mantine",
  "type": "module",
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./styles.layer.css": "./dist/styles.layer.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006 --no-open",
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "prepack": "pnpm build",
    "verify:package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "@mantine/core": "^9.6.1",
    "@mantine/hooks": "^9.6.1",
    "ai": "^7.0.99",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.102",
    "@biomejs/biome": "2.5.13",
    "@mantine/core": "9.6.1",
    "@mantine/hooks": "9.6.1",
    "@playwright/test": "1.63.0",
    "@storybook/react-vite": "10.6.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "ai": "7.0.99",
    "jsdom": "^27.0.0",
    "postcss-preset-mantine": "^1.18.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gtnao/mantine-ai-elements.git"
  },
  "keywords": [
    "mantine",
    "ai-sdk",
    "react",
    "components",
    "chat"
  ]
}
